{
  "schema_version": "re.teacher-edited-docx-style.v2",
  "page": {
    "size": "US Letter",
    "orientation": "portrait",
    "width_inches": 8.5,
    "height_inches": 11.0,
    "margin_left_inches": 0.62,
    "margin_right_inches": 0.62,
    "margin_top_inches": 0.55,
    "margin_bottom_inches": 0.55,
    "header_distance_inches": 0.25,
    "footer_distance_inches": 0.25
  },
  "fonts": {
    "latin": "Arial",
    "cjk_fallback": "Arial Unicode MS",
    "unit_title_pt": 19.0,
    "practice_book_label_pt": 12.5,
    "student_info_pt": 10.5,
    "section_heading_pt": 14.0,
    "exercise_bar_pt": 12.0,
    "exercise_bar_long_min_pt": 10.5,
    "student_body_pt": 11.0,
    "student_table_pt": 11.0,
    "student_minimum_pt": 10.5,
    "teacher_body_pt": 10.0,
    "teacher_minimum_pt": 9.0,
    "header_footer_pt": 8.0
  },
  "paragraphs": {
    "controlled_task_line_spacing": 1.5,
    "production_task_line_spacing": 2.0,
    "section_heading_space_before_pt": 1.0,
    "section_heading_space_after_pt": 3.0,
    "direction_space_before_pt": 2.0,
    "direction_space_after_pt": 3.0,
    "body_space_after_pt": 1.0
  },
  "colors": {
    "green": "267A5A",
    "green_dark": "1C6046",
    "green_pale": "EAF4EF",
    "gold": "C88A00",
    "gold_pale": "FFF5D9",
    "blue_pale": "EAF2F8",
    "gray_pale": "F3F5F6",
    "gray": "5E666B",
    "line": "B8C7C0",
    "ink": "202427",
    "white": "FFFFFF"
  },
  "language_policy": {
    "interface_default": "English only",
    "chinese_allowed": [
      "Chinese source sentences in Chinese-to-English translation tasks",
      "a teacher-requested gloss that is necessary to understand the operation"
    ],
    "student_info_fields": ["Name", "Class"],
    "omit_by_default": ["Date", "bilingual section subtitles", "bilingual directions"]
  },
  "student_page_grammar": [
    "section heading",
    "numbered exercise bar",
    "direct English instruction",
    "functional support",
    "numbered items with adjacent response space"
  ],
  "student_layout_rules": {
    "running_header": "Created by Culver Li",
    "word_bank_separator": "/",
    "word_bank_fill": "gold_pale",
    "find_answer_cells": "blank without underline glyphs",
    "ordinary_sentence_response_lines": 1,
    "translation_response_lines": 2,
    "visible_final_title_label": false,
    "word_table_widths_pt": [30.0, 324.0, 167.0],
    "phrase_table_widths_pt": [30.0, 283.0, 208.0]
  },
  "teacher_page_grammar": [
    "lesson title",
    "purpose/source/materials/preparation",
    "timed lesson stages",
    "board/display and anticipated errors",
    "homework and next-lesson check",
    "answers or judgment criteria"
  ]
}
